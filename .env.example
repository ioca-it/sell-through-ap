VITE_AUTH_CLIENT_ID=43ec8936-827e-44e2-8854-feecf70e5851
VITE_AUTH_API_SCOPE=api://08c8b9e6-336d-496b-8904-08ba9e96ea4b/access_as_user
VITE_API_BASE_URL=https://sell-through-ap-api.onrender.com

